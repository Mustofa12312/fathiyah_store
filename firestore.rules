rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to get the role of the current user
    function getUserRole() {
      return isAuthenticated() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    // Function to check specific roles
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isSupervisor() {
      return getUserRole() == 'supervisor' || isAdmin();
    }
    
    function isCashier() {
      return getUserRole() == 'cashier' || isSupervisor();
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Any authenticated user can read their own profile or if they are admin/supervisor they can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSupervisor());
      // Only Admin or Supervisor can create/update users
      // Users cannot create their own accounts via client app
      allow write: if isSupervisor();
    }
    
    // ============================================
    // AUDIT LOGS
    // ============================================
    match /audit_logs/{logId} {
      // Supervisor/Admin can view logs
      allow read: if isSupervisor();
      // Any authenticated user can create a log, but cannot update/delete them
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // ============================================
    // PRODUCTS, CATEGORIES, CUSTOMERS
    // ============================================
    match /products/{document=**} {
      allow read: if isCashier();
      allow write: if isSupervisor(); // Only supervisor/admin can edit products
    }
    
    match /categories/{document=**} {
      allow read: if isCashier();
      allow write: if isSupervisor();
    }

    match /customers/{document=**} {
      // Cashiers can read and create customers
      allow read, create: if isCashier();
      // Only supervisor/admin can update or delete customers
      allow update, delete: if isSupervisor();
    }
    
    // ============================================
    // SALES, SHIFTS, PAYMENTS, STOCK MOVEMENTS
    // ============================================
    match /sales/{document=**} {
      // Cashiers can read and create sales
      allow read, create, update: if isCashier();
      allow delete: if isSupervisor(); // Only supervisors can delete/void
    }
    
    match /shifts/{document=**} {
      allow read, write: if isCashier(); // Cashiers need to open/close shifts
    }
    
    match /stock_movements/{document=**} {
      allow read: if isCashier();
      allow write: if isCashier(); // Stock movements occur on sale
    }

    match /expenses/{document=**} {
      allow read, create: if isCashier();
      allow update, delete: if isSupervisor();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
